#!/usr/bin/env python3
"""infrachecks-metrics: send fresh service metrics to InfluxDB,
VictoriaMetrics or anything else that accepts InfluxDB line
protocol over HTTP. Run it as the site user every minute.

  infrachecks-metrics            send what's new since last run
  infrachecks-metrics --dry-run  print the lines, send nothing

Settings: ~/etc/infrachecks/metrics.ini (see the example in
~/local/share/doc/check_mk/infrachecks-metrics/).
Part of InfraChecks, GPLv2: github.com/segaudit-hq/infrachecks-plugins
"""
import configparser, json, os, re, socket, sys
import urllib.request

PERF = re.compile(r"('[^']+'|[^ =]+)=([-0-9.eE+]+)")


def esc(s):  # tag values: escape commas, spaces and equals
    return re.sub(r"([ ,=\\])", r"\\\1", s)


def services(root):
    q = ("GET services\nColumns: host_name description "
         "last_check perf_data\nFilter: perf_data != \n"
         "OutputFormat: json\n\n")
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(f"{root}/tmp/run/live")
        s.sendall(q.encode())
        s.shutdown(socket.SHUT_WR)
        return json.loads(b"".join(iter(lambda: s.recv(65536),
                                        b"")))


def lines(rows, seen):
    """Line protocol for results newer than the last run."""
    out, now_seen = [], {}
    for host, svc, last, perf in rows:
        key = f"{host};{svc}"
        now_seen[key] = last
        if seen.get(key) == last:
            continue  # no new check result since last run
        for name, value in PERF.findall(perf):
            try:
                value = float(value)
            except ValueError:
                continue
            out.append(f"checkmk,host={esc(host)},"
                       f"service={esc(svc)},"
                       f"metric={esc(name.strip(chr(39)))} "
                       f"value={value} {last}")
    return out, now_seen


def main(argv):
    root = os.environ.get("OMD_ROOT") or sys.exit(
        "run this as the site user")
    conf = f"{root}/etc/infrachecks/metrics.ini"
    state = f"{root}/var/infrachecks/metrics.json"
    ini = configparser.ConfigParser(interpolation=None)
    if not ini.read(conf) or not ini.get("target", "url",
                                         fallback=""):
        sys.exit(f"no target: set url = in [target] in {conf}")
    url, token = ini["target"]["url"], ini["target"].get("token")
    try:
        seen = json.load(open(state))
    except (OSError, ValueError):
        seen = {}
    out, now_seen = lines(services(root), seen)
    if "--dry-run" in argv:
        print("\n".join(out))
        print(f"{len(out)} points (dry run, nothing sent)")
        return
    if out:
        req = urllib.request.Request(
            url + ("&" if "?" in url else "?") + "precision=s",
            data="\n".join(out).encode(), method="POST")
        if token:
            req.add_header("Authorization", f"Token {token}")
        try:
            urllib.request.urlopen(req, timeout=20).read()
        except OSError as e:
            sys.exit(f"write to {url} failed: {e}")  # not saved
    os.makedirs(os.path.dirname(state), exist_ok=True)
    with open(state + ".tmp", "w") as f:
        json.dump(now_seen, f)
    os.replace(state + ".tmp", state)
    print(f"{len(out)} points written")


if __name__ == "__main__":
    main(sys.argv[1:])
